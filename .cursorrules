## 16. Configuration File Templates

### `.editorconfig`
```ini
root = true
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
[*.py]
indent_size = 4
[Makefile]
indent_style = tab
```

### `.gitignore`
```gitignore
# Python
__pycache__/
*.pyc
.venv/
# Node
node_modules/
# Secrets & local configs
.env
.env.*
config/config.yaml
.secrets/
# Build artifacts
build/
dist/
coverage/
# Agent scratch docs
tests/_md_scratch/
```

### `pyproject.toml`
```toml
[tool.black]
line-length = 100
[tool.ruff]
line-length = 100
select = ["E", "F", "I"]
fix = true
[tool.mypy]
python_version = "3.11"
ignore_missing_imports = true
[tool.pytest.ini_options]
minversion = "7.0"
addopts = "-q"
testpaths = ["tests"]
[build-system]
requires = ["setuptools", "wheel"]
build-backend = "setuptools.build_meta"
```

### `package.json`
```json
{
  "name": "repo-guardrails-template",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier -w .",
    "commitmsg": "commitlint --edit $GIT_PARAMS"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0"
  }
}
```

### `.pre-commit-config.yaml`
```yaml
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.6.0
    hooks:
      - id: check-merge-conflict
      - id: end-of-file-fixer
      - id: trailing-whitespace
      - id: check-yaml
      - id: check-json
  - repo: https://github.com/charliermarsh/ruff-pre-commit
    rev: v0.6.9
    hooks:
      - id: ruff
      - id: ruff-format
  - repo: https://github.com/psf/black
    rev: 24.8.0
    hooks:
      - id: black
  - repo: https://github.com/pre-commit/mirrors-prettier
    rev: v4.0.0-alpha.8
    hooks:
      - id: prettier
        files: \.(js|ts|tsx|css|json|md)$
  - repo: https://github.com/kucherenko/jscpd
    rev: "3.5.10"
    hooks:
      - id: jscpd
        args: ["--config", ".jscpd.json"]
  - repo: https://github.com/Yelp/detect-secrets
    rev: v1.5.0
    hooks:
      - id: detect-secrets
        args: ["--baseline", ".secrets.baseline"]
```

